<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LegalAssistantApp.ViewModels;assembly=LegalAssistantApp"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:converters="clr-namespace:LegalAssistantApp.Converters;assembly=LegalAssistantApp"
        xmlns:loc="clr-namespace:LegalAssistantApp.Localization;assembly=LegalAssistantApp"
        x:Class="LegalAssistantApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Legal Assistant" 
        Width="1400" Height="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:NotNullToBoolConverter x:Key="NotNullToBoolConverter" />
        <converters:EventStatusToColorConverter x:Key="EventStatusToColorConverter" />
        <converters:DateTimeToDateOnlyConverter x:Key="DateTimeToDateOnlyConverter" />
        <converters:DateTimeToNullableConverter x:Key="DateTimeToNullableConverter" />
        <converters:SafeBindingConverter x:Key="SafeBindingConverter" />
        <converters:DecimalConverter x:Key="DecimalConverter" />
        <converters:StatusRiskToRussianConverter x:Key="StatusRiskToRussianConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- Основные стили -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBackground}"/>
        </Style>

        <!-- Левая панель -->
        <Style Selector="Border#sidebar">
            <Setter Property="Background" Value="{DynamicResource ThemeSidebarBackground}" />
            <Setter Property="Width" Value="280"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
        </Style>

        <!-- Кнопки меню -->
        <Style Selector="Button.menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style Selector="Button.menu:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>

        <Style Selector="Button.menu:pressed">
            <Setter Property="Background" Value="#5a6a62"/>
        </Style>

        <!-- Кнопка выхода -->
        <Style Selector="Button.logout">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryColor}"/>
            <Setter Property="Foreground" Value="#ff9999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="20,10,20,20"/>
        </Style>

        <Style Selector="Button.logout:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
        </Style>

        <!-- Текст в полях ввода и watermark -->
        <Style Selector="TextBox TextPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeTextPrimary}" />
        </Style>

        <Style Selector="TextBox:watermark TextPresenter">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeTextMuted}" />
        </Style>

        <!-- На некоторых темах/контролах водяной знак может быть TextBlock -->
        <Style Selector="TextBox TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
        </Style>

        <Style Selector="TextBox:watermark TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}" />
        </Style>

        <!-- Карточки -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Заголовки секций -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Заголовки полей -->
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Поля ввода -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
        </Style>

        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}"/>
        </Style>
        
        <!-- (дубли ниже удалены; стили выше покрывают ввод и watermark) -->

        <!-- Ошибки валидации -->
        <Style Selector="TextBox:validationerror">
            <Setter Property="BorderBrush" Value="#b35454"/>
            <Setter Property="BorderThickness" Value="2"/>
            <!-- В Dark-теме не делаем "белый" фон, чтобы текст не пропадал -->
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
        </Style>

        <!-- Кнопки действий -->
        <Style Selector="Button.action-btn">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.primary-btn:pointerover">
            <Setter Property="Background" Value="#4a7a6a"/>
        </Style>

        <Style Selector="Button.success-btn">
            <Setter Property="Background" Value="#4a8a6a"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.success-btn:pointerover">
            <Setter Property="Background" Value="#3a7a5a"/>
        </Style>

        <Style Selector="Button.danger-btn">
            <Setter Property="Background" Value="#b35454"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.danger-btn:pointerover">
            <Setter Property="Background" Value="#a34444"/>
        </Style>

        <Style Selector="Button.secondary-btn">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
        </Style>

        <Style Selector="Button.secondary-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
        </Style>

        <!-- DataGrid стили -->
        <Style Selector="dg|DataGrid">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="dg|DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeSecondaryColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="dg|DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
        </Style>

        <Style Selector="dg|DataGridCell">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>

        <Style Selector="dg|DataGridCell TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>

        <Style Selector="dg|DataGridRow">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
        </Style>

        <Style Selector="dg|DataGridRow:selected">
            <Setter Property="Background" Value="{DynamicResource ThemeSelectedBackground}"/>
        </Style>

        <!-- CheckBox стили -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <Style Selector="CheckBox:checked">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <Style Selector="CheckBox TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <Style Selector="CheckBox:checked TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>

        <!-- DatePicker стили -->
        <Style Selector="DatePicker">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="DatePicker:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>

        <Style Selector="DatePicker TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>

        <!-- ComboBox стили -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ComboBox TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <!-- ListBox стили -->
        <Style Selector="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <Style Selector="ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
        
        <Style Selector="ListBoxItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
        </Style>
    </Window.Styles>

    <Window.DataTemplates>
        <!-- Домашний экран -->
        <DataTemplate DataType="vm:MainWindowViewModel">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBlock Text="Выберите раздел в меню слева для начала работы"
                               FontSize="14"
                               Foreground="{DynamicResource ThemeTextMuted}"/>
                </StackPanel>

                <!-- Ближайшие события на главной панели -->
                <Border Grid.Row="1" Classes="card">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="{Binding UpcomingEventsTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   Margin="0,0,0,10"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding HomeUpcomingEvents}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource ThemeCardBackground}"
                                 Foreground="{DynamicResource ThemeTextPrimary}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="8,6" Margin="0,1">
                                        <Grid ColumnDefinitions="2*,2*,*,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Document.Title, TargetNullValue='-'}"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding EventDate, StringFormat='dd.MM.yyyy HH:mm'}"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Status}"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource ThemeSelectedBackground}"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Раздел Контрагенты -->
        <DataTemplate DataType="vm:CounterpartyViewModel">
            <Grid RowDefinitions="Auto,*" Margin="10">
                <!-- Панель управления -->
                <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,20">
                    <TextBlock Text="Управление контрагентами"
                               Classes="section-title"/>
                    
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Height="40"
                                 Watermark="Поиск по наименованию, ИНН, ОГРН"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="1"
                                Content="Найти"
                                Classes="action-btn secondary-btn"
                                Command="{Binding SearchCommand}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="2"
                                Content="Добавить"
                                Classes="action-btn success-btn"
                                Command="{Binding AddNewCommand}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="3"
                                Content="Сохранить"
                                Classes="action-btn primary-btn"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding SelectedCounterparty, Converter={StaticResource NotNullToBoolConverter}}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="4"
                                Content="Удалить"
                                Classes="action-btn danger-btn"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding SelectedCounterparty, Converter={StaticResource NotNullToBoolConverter}}"/>
                    </Grid>

                    <!-- API ФНС -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="API ФНС:"
                                   VerticalAlignment="Center"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource ThemeTextPrimary}"/>
                        
                        <TextBox Grid.Column="1"
                                 Height="36"
                                 Text="{Binding FnsApiKey, Mode=TwoWay}"
                                 Watermark="Введите ключ доступа к API ФНС"
                                 IsEnabled="{Binding SelectedCounterparty, Converter={StaticResource NotNullToBoolConverter}}"
                                 Margin="12,0,12,0"/>
                        
                        <Button Grid.Column="2"
                                Content="Проверить"
                                Classes="action-btn secondary-btn"
                                Command="{Binding CheckWithFnsCommand}"
                                IsEnabled="{Binding SelectedCounterparty, Converter={StaticResource NotNullToBoolConverter}}"/>
                    </Grid>
                    
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource ThemeTextSecondary}"
                               FontSize="13"
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- Основной контент -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,*">
                    <!-- Список контрагентов (список-таблица) -->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Список контрагентов"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       Margin="0,0,0,16"/>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Counterparties}"
                                     SelectedItem="{Binding SelectedCounterparty, Mode=TwoWay}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent"
                                                Padding="6"
                                                Margin="0,1">
                                            <Grid ColumnDefinitions="3*,*,*,*,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding INN}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding OGRN}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Status, Converter={StaticResource StatusRiskToRussianConverter}}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding RiskLevel, Converter={StaticResource StatusRiskToRussianConverter}}"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Форма редактирования -->
                    <Border Grid.Column="1" Classes="card">
                        <ScrollViewer>
                            <StackPanel Spacing="16">
                                <TextBlock Text="Редактирование"
                                           Classes="section-title"/>

                                <StackPanel Spacing="12">
                                    <TextBlock Text="Краткое наименование *"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.Name, Mode=TwoWay}"/>

                                    <TextBlock Text="Тип контрагента *"
                                               Classes="field-label"/>
                                    <ComboBox SelectedItem="{Binding SelectedCounterparty.Type, Mode=TwoWay}"
                                              Padding="12,10">
                                        <ComboBox.Items>
                                            <x:String>Юр.лицо</x:String>
                                            <x:String>Физ.лицо</x:String>
                                        </ComboBox.Items>
                                    </ComboBox>

                                    <TextBlock Text="Полное наименование"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.FullName, Mode=TwoWay}"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="ИНН *"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding SelectedCounterparty.INN, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="КПП *"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding SelectedCounterparty.KPP, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="ОГРН"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.OGRN, Mode=TwoWay}"/>

                                    <TextBlock Text="Юридический адрес"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.LegalAddress, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             Height="60"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Телефон *"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding SelectedCounterparty.Phone, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Email *"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding SelectedCounterparty.Email, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Контактное лицо *"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.ContactPerson, Mode=TwoWay}"/>

                                    <TextBlock Text="Директор"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.DirectorName, Mode=TwoWay}"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Статус"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding SelectedCounterparty.Status, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Уровень риска"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding SelectedCounterparty.RiskLevel, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Заметки"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedCounterparty.Notes, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             Height="80"/>
                                </StackPanel>

                                <!-- Результаты проверки ФНС -->
                                <Border Background="{DynamicResource ThemeHoverBackground}"
                                        CornerRadius="6"
                                        Padding="16"
                                        Margin="0,20,0,0"
                                        IsVisible="{Binding LastAuditHistory}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Результаты проверки ФНС"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                                   Margin="0,0,0,8"/>
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                <TextBlock Text="Источник:"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LastAuditHistory.Source}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                <TextBlock Text="Дата проверки:"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LastAuditHistory.CheckDate, StringFormat='dd.MM.yyyy HH:mm'}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                                <TextBlock Text="Уровень риска:"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource ThemeTextSecondary}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LastAuditHistory.RiskLevel}"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource ThemeTextPrimary}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="Результаты:"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                                       Margin="0,4,0,2"/>
                                            <TextBlock Text="{Binding LastAuditHistory.Findings}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Раздел Документы -->
        <DataTemplate DataType="vm:DocumentViewModel">
            <Grid RowDefinitions="Auto,*" Margin="10">
                <!-- Панель управления -->
                <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,20">
                    <TextBlock Text="Управление документами"
                               Classes="section-title"/>
                    
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Height="40"
                                 Watermark="Поиск по названию, номеру, тегам"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="1"
                                Content="Найти"
                                Classes="action-btn secondary-btn"
                                Command="{Binding SearchCommand}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="2"
                                Content="Сканировать диски"
                                Classes="action-btn success-btn"
                                Command="{Binding ScanDisksCommand}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="3"
                                Content="Добавить"
                                Classes="action-btn success-btn"
                                Command="{Binding AddNewCommand}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="4"
                                Content="Сохранить"
                                Classes="action-btn primary-btn"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="5"
                                Content="Удалить"
                                Classes="action-btn danger-btn"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="6"
                                Content="Открыть"
                                Classes="action-btn secondary-btn"
                                Command="{Binding OpenFileCommand}"
                                IsEnabled="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}"
                                Margin="0,0,12,0"/>

                        <Button Grid.Column="7"
                                Content="Отчёт PDF"
                                Classes="action-btn secondary-btn"
                                Command="{Binding ExportReportCommand}"
                                IsEnabled="{Binding Documents.Count}"/>
                    </Grid>
                    
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#4a8a6a"
                               FontSize="13"
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- Основной контент -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,*">
                    <!-- Таблица документов -->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,12,0" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*" ClipToBounds="True">
                            <TextBlock Text="Список документов"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}"
                                       Margin="0,0,0,16"/>

                            <!-- Отладочная информация -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Documents.Count, StringFormat='Количество документов: {0}'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       Margin="0,0,0,8"
                                       IsVisible="{Binding Documents.Count, Converter={StaticResource NotNullToBoolConverter}}"/>

                            <ListBox x:Name="DocumentsListBox"
                                    Grid.Row="2"
                                    ItemsSource="{Binding Documents}"
                                    SelectedItem="{Binding SelectedDisplayItem, Mode=TwoWay}"
                                    Background="{DynamicResource ThemeCardBackground}"
                                    Foreground="{DynamicResource ThemeTextPrimary}"
                                    MinHeight="500"
                                    VerticalAlignment="Stretch"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ClipToBounds="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8,6" Margin="0,1" ClipToBounds="True">
                                            <Grid ColumnDefinitions="3*,*,*,*,*" ClipToBounds="True">
                                                <TextBlock Grid.Column="0" 
                                                          Text="{Binding Title}" 
                                                          FontWeight="Medium"
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="1" 
                                                          Text="{Binding DocumentNumber, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="2" 
                                                          Text="{Binding DocumentType, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="3" 
                                                          Text="{Binding Status, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="4" 
                                                          Text="{Binding DocumentDateString, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSelectedBackground}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Форма редактирования -->
                    <Border Grid.Column="1" Classes="card">
                        <ScrollViewer>
                            <StackPanel Spacing="16" DataContext="{Binding}">
                                <!-- Форма редактирования (видна когда документ выбран) -->
                                <StackPanel Spacing="16" IsVisible="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}">
                                    <TextBlock Text="Редактирование документа"
                                               Classes="section-title"/>

                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Название"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SelectedDocument.Title, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"/>

                                        <TextBlock Text="Номер документа"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SelectedDocument.DocumentNumber, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"/>

                                        <TextBlock Text="Тип документа"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SelectedDocument.DocumentType, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"/>

                                        <TextBlock Text="Статус"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SelectedDocument.Status, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"/>

                                        <TextBlock Text="Дата документа"
                                                   Classes="field-label"/>
                                        <DatePicker SelectedDate="{Binding SelectedDocumentDate, Mode=TwoWay, Converter={StaticResource DateTimeToNullableConverter}}"
                                                    Padding="12,10"/>

                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                                <TextBlock Text="Сумма"
                                                           Classes="field-label"/>
                                                <TextBox Text="{Binding SelectedDocument.Amount, Mode=TwoWay, Converter={StaticResource DecimalConverter}, TargetNullValue='0', FallbackValue='0'}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                                <TextBlock Text="Валюта"
                                                           Classes="field-label"/>
                                                <TextBox Text="{Binding SelectedDocument.Currency, Mode=TwoWay, TargetNullValue='RUB', FallbackValue='RUB'}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Теги (через запятую)"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SelectedDocument.Tags, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"/>

                                        <TextBlock Text="Контрагент"
                                                   Classes="field-label"/>
                                        <ComboBox ItemsSource="{Binding Counterparties}"
                                                  SelectedItem="{Binding SelectedDocument.Counterparty, Mode=TwoWay}"
                                                  Padding="12,10">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <CheckBox Content="Конфиденциальный документ"
                                                  IsChecked="{Binding SelectedDocument.IsConfidential, Mode=TwoWay, TargetNullValue=False, FallbackValue=False}"/>

                                        <TextBlock Text="Файл"
                                                   Classes="field-label"/>
                                        <TextBlock Text="{Binding SelectedDocument.FileName, TargetNullValue='Файл не выбран', FallbackValue='Файл не выбран'}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource ThemeTextSecondary}"/>

                                        <TextBlock Text="Содержание (краткое описание)"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SelectedDocument.Content, Mode=TwoWay, TargetNullValue='', FallbackValue=''}"
                                                 AcceptsReturn="True"
                                                 Height="100"/>
                                    </StackPanel>
                                    
                                    <!-- Кнопки действий -->
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,20,0,0">
                                        <Button Grid.Column="0"
                                                Content="Сохранить"
                                                Classes="action-btn primary-btn"
                                                Command="{Binding SaveCommand}"
                                                IsEnabled="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,4,0"/>
                                        
                                        <Button Grid.Column="1"
                                                Content="Удалить"
                                                Classes="action-btn danger-btn"
                                                Command="{Binding DeleteCommand}"
                                                IsEnabled="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}"
                                                HorizontalAlignment="Stretch"
                                                Margin="4,0,4,0"/>
                                        
                                        <Button Grid.Column="2"
                                                Content="Открыть"
                                                Classes="action-btn secondary-btn"
                                                Command="{Binding OpenFileCommand}"
                                                IsEnabled="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}}"
                                                HorizontalAlignment="Stretch"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Сообщение (видно когда документ не выбран) -->
                                <StackPanel Spacing="16" IsVisible="{Binding SelectedDocument, Converter={StaticResource NotNullToBoolConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="Выберите документ из списка для редактирования"
                                               Classes="section-title"
                                               Foreground="{DynamicResource ThemeTextMuted}"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Раздел События -->
        <DataTemplate DataType="vm:EventsViewModel">
            <Grid RowDefinitions="Auto,*" Margin="10">
                <!-- Панель управления -->
                <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,20">
                    <TextBlock Text="Календарь событий"
                               Classes="section-title"/>
                    
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Height="40"
                                 Watermark="Поиск событий"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 Margin="0,0,12,0"/>
                        
                        <TextBlock Grid.Column="1"
                                   Text="{Binding EventsUntilLabel}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource ThemeTextSecondary}"/>
                        
                        <DatePicker Grid.Column="2"
                                    SelectedDate="{Binding UntilDate, Mode=TwoWay, Converter={StaticResource DateTimeToNullableConverter}}"
                                    Padding="12,10"
                                    Margin="12,0,12,0"/>
                        
                        <Button Grid.Column="3"
                                Content="Добавить"
                                Classes="action-btn success-btn"
                                Command="{Binding AddNewEventCommand}"
                                Margin="0,0,12,0"/>
                        
                        <Button Grid.Column="4"
                                Content="Обновить"
                                Classes="action-btn secondary-btn"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsLoading}"/>
                        
                        <Button Grid.Column="5"
                                Content="Экспорт"
                                Classes="action-btn secondary-btn"
                                Command="{Binding ExportCommand}"/>
                    </Grid>
                    
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusColor}"
                               FontSize="13"
                               FontWeight="Medium"/>
                </StackPanel>

                <!-- Основной контент -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,*">
                    <!-- Таблица событий -->
                    <Border Grid.Column="0" Classes="card" Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                                <TextBlock Text="{Binding UpcomingEventsLabel}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeTextPrimary}"/>
                                
                                <ProgressBar IsIndeterminate="True" 
                                           IsVisible="{Binding IsLoading}"
                                           Width="100"/>
                            </StackPanel>

                            <!-- Отладочная информация -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding UpcomingEvents.Count, StringFormat='Количество событий: {0}'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       Margin="0,0,0,8"
                                       IsVisible="{Binding UpcomingEvents.Count, Converter={StaticResource NotNullToBoolConverter}}"/>

                            <ListBox x:Name="EventsListBox"
                                    Grid.Row="2"
                                    ItemsSource="{Binding UpcomingEvents}"
                                    SelectedItem="{Binding SelectedDisplayItem, Mode=TwoWay}"
                                    Background="{DynamicResource ThemeCardBackground}"
                                    Foreground="{DynamicResource ThemeTextPrimary}"
                                    VerticalAlignment="Stretch"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="8,6" Margin="0,1" ClipToBounds="True">
                                            <Grid ColumnDefinitions="2*,2*,*,*,*" ClipToBounds="True">
                                                <TextBlock Grid.Column="0" 
                                                          Text="{Binding Title}" 
                                                          FontWeight="Medium"
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="1" 
                                                          Text="{Binding DocumentTitle, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="2" 
                                                          Text="{Binding EventType, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="3" 
                                                          Text="{Binding EventDateString, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                                <TextBlock Grid.Column="4" 
                                                          Text="{Binding Status, TargetNullValue='-'}" 
                                                          Foreground="{DynamicResource ThemeTextPrimary}"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"
                                                          TextWrapping="NoWrap"
                                                          ClipToBounds="True"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSelectedBackground}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Форма редактирования события -->
                    <Border Grid.Column="1" Classes="card">
                        <ScrollViewer>
                            <StackPanel Spacing="16">
                                <TextBlock Text="{Binding EditEventLabel}"
                                           Classes="section-title"/>

                                <StackPanel Spacing="12" IsVisible="{Binding SelectedEvent, Converter={StaticResource NotNullToBoolConverter}}"
                                            Name="EventEditPanel">
                                    <TextBlock Text="Название события"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedEvent.Title, Mode=TwoWay, TargetNullValue=''}"/>

                                    <TextBlock Text="Описание"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding SelectedEvent.Description, Mode=TwoWay, TargetNullValue=''}"
                                             AcceptsReturn="True"
                                             Height="80"/>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Дата события"
                                                       Classes="field-label"/>
                                            <DatePicker SelectedDate="{Binding SelectedEventDate, Mode=TwoWay, Converter={StaticResource DateTimeToNullableConverter}}"
                                                        Padding="12,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Время (HH:mm)"
                                                       Classes="field-label"/>
                                            <TextBox Text="{Binding EventTime, Mode=TwoWay}"
                                                     Watermark="12:00"
                                                     Padding="12,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Тип события"
                                                       Classes="field-label"/>
                                            <ComboBox SelectedItem="{Binding SelectedEvent.EventType, Mode=TwoWay, TargetNullValue=''}"
                                                      ItemsSource="{Binding EventTypes}"
                                                      Padding="12,10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Статус"
                                                       Classes="field-label"/>
                                            <ComboBox SelectedItem="{Binding SelectedEvent.Status, Mode=TwoWay, TargetNullValue=''}"
                                                      ItemsSource="{Binding EventStatuses}"
                                                      Padding="12,10"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                            <TextBlock Text="Связанный документ"
                                                       Classes="field-label"/>
                                            <ComboBox SelectedItem="{Binding SelectedEvent.Document, Mode=TwoWay}"
                                                      ItemsSource="{Binding Documents}"
                                                      Padding="12,10">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Title}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                            <TextBlock Text="Контрагент"
                                                       Classes="field-label"/>
                                            <ComboBox SelectedItem="{Binding SelectedEvent.Counterparty, Mode=TwoWay}"
                                                      ItemsSource="{Binding Counterparties}"
                                                      Padding="12,10">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Настройки напоминания -->
                                    <Border Background="{DynamicResource ThemeHoverBackground}"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,12,0,0">
                                        <StackPanel Spacing="8">
                                            <CheckBox Content="Включить напоминание"
                                                      IsChecked="{Binding SelectedEvent.HasReminder, Mode=TwoWay, TargetNullValue=False}"/>
                                            
                                            <Grid ColumnDefinitions="*,*" IsVisible="{Binding SelectedEvent.HasReminder, TargetNullValue=False}">
                                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                                    <TextBlock Text="Напомнить за:"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                    <ComboBox ItemsSource="{Binding ReminderOptions}"
                                                              SelectedItem="{Binding SelectedReminderOption, Mode=TwoWay}"
                                                              Padding="12,10"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                                    <TextBlock Text="Email уведомления:"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                    <TextBox Text="{Binding SelectedEvent.NotificationEmail, Mode=TwoWay, TargetNullValue=''}"
                                                             Padding="12,10"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Кнопки действий -->
                                    <Grid ColumnDefinitions="*,*,*" Margin="0,20,0,0">
                                        <Button Grid.Column="0"
                                                Content="Сохранить"
                                                Classes="action-btn primary-btn"
                                                Command="{Binding SaveEventCommand}"
                                                IsEnabled="{Binding SelectedEvent, Converter={StaticResource NotNullToBoolConverter}}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,0,4,0"/>
                                        
                                        <Button Grid.Column="1"
                                                Content="Завершить"
                                                Classes="action-btn success-btn"
                                                Command="{Binding MarkCompletedCommand}"
                                                CommandParameter="{Binding SelectedEvent}"
                                                IsEnabled="{Binding SelectedEvent, Converter={StaticResource NotNullToBoolConverter}}"
                                                HorizontalAlignment="Stretch"
                                                Margin="4,0,4,0"/>
                                        
                                        <Button Grid.Column="2"
                                                Content="Удалить"
                                                Classes="action-btn danger-btn"
                                                Command="{Binding DeleteEventCommand}"
                                                IsEnabled="{Binding SelectedEvent, Converter={StaticResource NotNullToBoolConverter}}"
                                                HorizontalAlignment="Stretch"
                                                Margin="4,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                                
                                <!-- Сообщение, когда событие не выбрано -->
                                <StackPanel Spacing="12" 
                                            IsVisible="{Binding SelectedEvent, Converter={StaticResource NotNullToBoolConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="Выберите событие из списка для редактирования"
                                               Classes="section-title"
                                               Foreground="{DynamicResource ThemeTextMuted}"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Раздел Настройки -->
        <DataTemplate DataType="vm:SettingsViewModel">
            <Grid RowDefinitions="Auto,*" Margin="10">
                <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,20">
                    <TextBlock Text="{Binding ApplicationSettingsTitle}"
                               Classes="section-title"/>
                </StackPanel>

                <Border Grid.Row="1" Classes="card">
                    <ScrollViewer>
                        <StackPanel Spacing="20">
                            <!-- Язык -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding LanguageLabel}"
                                           Classes="field-label"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                          Padding="12,10"/>
                            </StackPanel>

                            <!-- Тема -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding ThemeLabel}"
                                           Classes="field-label"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding Themes}"
                                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                          Padding="12,10"/>
                            </StackPanel>

                            <!-- Настройки Email / SMTP -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Подключение почты (SMTP)"
                                           Classes="field-label"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="SMTP хост"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SmtpHost, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="Порт"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SmtpPort, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                        <TextBlock Text="Логин"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SmtpUser, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                        <TextBlock Text="Пароль / пароль приложения"
                                                   Classes="field-label"/>
                                        <TextBox Text="{Binding SmtpPassword, Mode=TwoWay}"
                                                 PasswordChar="●"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Отправитель (From Email)"
                                               Classes="field-label"/>
                                    <TextBox Text="{Binding FromEmail, Mode=TwoWay}"/>
                                </StackPanel>

                                <CheckBox Content="Использовать SSL/TLS"
                                          IsChecked="{Binding SmtpUseSsl, Mode=TwoWay}"/>

                                <TextBlock Text="Подсказка: для Gmail используйте smtp.gmail.com:587 с SSL; для Яндекс — smtp.yandex.ru:465/587; для Mail.ru — smtp.mail.ru:465/587."
                                           FontSize="11"
                                           Foreground="{DynamicResource ThemeTextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Сообщение о статусе -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="#4a8a6a"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            <!-- Кнопка сохранения -->
                            <Button Content="{Binding SaveSettingsButton}"
                                    Classes="action-btn primary-btn"
                                    Command="{Binding SaveSettingsCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0" x:Name="sidebar">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Верхняя часть боковой панели: просто разделитель -->
                <Border Padding="16,20" BorderThickness="0,0,0,1" BorderBrush="#3a4a42">
                    <TextBlock Text="{Binding NavigationLabel}"
                               FontSize="13"
                               Foreground="#a0b8b0"
                               HorizontalAlignment="Left"/>
                </Border>

                <!-- Навигация -->
                <StackPanel Grid.Row="1" Spacing="4" Margin="12,20,12,0">
                    <Button Content="{Binding CounterpartiesLabel}"
                            Classes="menu"
                            Command="{Binding ShowCounterpartiesCommand}"/>
                    <Button Content="{Binding DocumentsLabel}"
                            Classes="menu"
                            Command="{Binding ShowDocumentsCommand}"/>
                    <Button Content="{Binding EventsLabel}"
                            Classes="menu"
                            Command="{Binding ShowEventsCommand}"/>
                    <Button Content="{Binding SettingsLabel}"
                            Classes="menu"
                            Command="{Binding ShowSettingsCommand}"/>
                </StackPanel>

                <!-- Нижняя часть -->
                <Border Grid.Row="2" Padding="12,20,12,12">
                    <StackPanel Spacing="8">
                        <!-- Информация о пользователе скрыта -->
                        <StackPanel Spacing="6" Margin="12,12,12,0" IsVisible="False">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#e0e8e4"/>
                            <TextBlock Text="{Binding CurrentUserRole}"
                                       FontSize="11"
                                       Foreground="#a0b8b0"/>
                        </StackPanel>
                        <Button Content="{Binding LogoutLabel}"
                                Classes="logout"
                                HorizontalAlignment="Left"
                                Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="{DynamicResource ThemeWindowBackground}">
            <Grid RowDefinitions="Auto,*">
                <!-- Верхняя панель -->
                <Border Background="{DynamicResource ThemeSecondaryColor}" 
                        BorderBrush="{DynamicResource ThemeBorderColor}"
                        BorderThickness="0,0,0,1"
                        Padding="24,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <!-- Информация о пользователе скрыта -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="False">
                            <TextBlock Text="{Binding CurrentUserName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="{Binding CurrentUserRole}"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentDateTime, StringFormat='dd.MM.yyyy HH:mm'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource ThemeTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="v1.0"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Область контента -->
                <ContentControl Grid.Row="1" 
                               Margin="24" 
                               Content="{Binding CurrentContent}"/>
            </Grid>
        </Border>
    </Grid>
</Window>