<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LegalAssistantApp.ViewModels;assembly=LegalAssistantApp"
        x:Class="LegalAssistantApp.Views.LoginWindow"
        x:DataType="vm:AuthViewModel"
        Title="Вход в систему"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        FontFamily="Segoe UI">

  <Window.Styles>
    <Style Selector="Button.login">
      <Setter Property="Background" Value="#2e7d32" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#2e7d32" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.login:pointerover">
      <Setter Property="Background" Value="#27642a" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#27642a" />
    </Style>
  </Window.Styles>

  <Grid Background="#e5e9f0">
    <Border Width="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="12"
            Padding="24">
      <StackPanel Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Добро пожаловать!"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="#2e7d32"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Аутентификация пользователя"
                     FontSize="14"
                     Foreground="#666"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Логин"
                     FontWeight="SemiBold"
                     Foreground="#444" />
          <TextBox Text="{Binding Username}"
                   Watermark="Введите логин"
                   Height="32" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Пароль"
                     FontWeight="SemiBold"
                     Foreground="#444" />
          <TextBox Text="{Binding Password}"
                   PasswordChar="●"
                   Watermark="Введите пароль"
                   Height="32" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#d32f2f"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MinHeight="20" />

        <Button Content="Войти"
                Classes="login"
                Command="{Binding LoginCommand}"
                FontWeight="SemiBold"
                FontSize="15"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,12,0,0" />

        <TextBlock Text="Тестовый доступ: admin / admin123"
                   FontSize="11"
                   Foreground="#888"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>