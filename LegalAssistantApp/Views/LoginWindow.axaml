<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LegalAssistantApp.ViewModels;assembly=LegalAssistantApp"
        x:Class="LegalAssistantApp.Views.LoginWindow"
        x:DataType="vm:AuthViewModel"
        Title="Аутентификация"
        Width="500"
        Height="500"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        FontFamily="Segoe UI">
    
    <StackPanel Margin="40" Spacing="20" Background="#f8f9fa">
        <TextBlock Text="Добро пожаловать в систему" 
                   FontSize="24" 
                   Foreground="#2e7d32"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        
        <TextBlock Text="Аутентификация" 
                   FontSize="18" 
                   Foreground="#4caf50"
                   HorizontalAlignment="Center"/>
        
        <StackPanel Spacing="10">
            <TextBlock Text="Логин" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox Text="{Binding Username}"/>
            
            <TextBlock Text="Пароль" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox Text="{Binding Password}" PasswordChar="*"/>
            
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#d32f2f" 
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
            
            <Button Content="Вход" 
                    Command="{Binding LoginCommand}"
                    Background="#4caf50"
                    Foreground="White"
                    Padding="20,10"
                    Margin="0,20,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>