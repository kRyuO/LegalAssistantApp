<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LegalAssistantApp.ViewModels;assembly=LegalAssistantApp"
        x:Class="LegalAssistantApp.Views.LoginWindow"
        x:DataType="vm:AuthViewModel"
        Title="Вход в систему"
        Width="480"
        Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        FontFamily="Segoe UI">

  <Window.Styles>
    <!-- Поля ввода: чёткий контур, как в основном окне -->
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderColor}" />
      <Setter Property="Background" Value="{DynamicResource ThemeCardBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="TextBox:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}" />
    </Style>

    <!-- В Avalonia ввод рисуется через TextPresenter внутри шаблона -->
    <Style Selector="TextBox TextPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeTextPrimary}" />
    </Style>

    <Style Selector="TextBox:watermark TextPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ThemeTextMuted}" />
    </Style>

    <!-- На некоторых темах/контролах водяной знак может быть TextBlock -->
    <Style Selector="TextBox TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}" />
    </Style>

    <Style Selector="TextBox:watermark TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}" />
    </Style>

    <Style Selector="Button.login">
      <Setter Property="Background" Value="{DynamicResource ThemePrimaryColor}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.login:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeHoverBackground}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryColor}" />
    </Style>
  </Window.Styles>

  <Grid Background="{DynamicResource ThemeWindowBackground}">
    <Border Width="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource ThemeCardBackground}"
            CornerRadius="12"
            Padding="24">
      <StackPanel Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="Добро пожаловать!"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{DynamicResource ThemePrimaryColor}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="Аутентификация пользователя"
                     FontSize="14"
                     Foreground="{DynamicResource ThemeTextSecondary}"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Логин"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimary}" />
          <TextBox Text="{Binding Username}"
                   Watermark="Введите логин"
                   Height="40"
                   VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Пароль"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimary}" />
          <TextBox Text="{Binding Password}"
                   PasswordChar="●"
                   Watermark="Введите пароль"
                   Height="40"
                   VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}"
                  Foreground="#d32f2f"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MinHeight="20" />

        <!-- кнопка входа -->
        <Button Content="Войти"
                Classes="login"
                Command="{Binding LoginCommand}"
                FontWeight="SemiBold"
                FontSize="15"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,12,0,0" />

      </StackPanel>
    </Border>
  </Grid>
</Window>